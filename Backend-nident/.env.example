APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Offset MySQL para alinear NOW() con America/Lima en hostings que usan UTC
APP_TIMEZONE=America/Lima
DB_TIMEZONE=-05:00

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ventas@valentostile.pe
MAIL_FROM_NAME="Valento"
MAIL_CONTACT_TO=ventas@valentostile.pe
# PROD cPanel:
# MAIL_HOST=mail.rossety.pe
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=ventas@valentostile.pe
# MAIL_PASSWORD=********

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


RECAPTCHA_SITE_KEY=TU_SITE_KEY_V2_CHECKBOX
RECAPTCHA_SECRET_KEY=TU_SECRET_KEY_V2_CHECKBOX

# Web Push (alertas campus con navegador minimizado)
# Generar: php artisan notificacion:vapid-generar
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ventas@valentostile.pe
FRONTEND_URL=https://rossety.pe/admin

# Panel admin (React) — solo en local
# APP_URL_FROND=http://localhost:5173
# ADMIN_DIST_PATH=   # vacío → Laravel redirige a Vite; no usa public/admin
# ADMIN_DIST_PATH=C:/xampp/htdocs_pro/37-masajes-royal/systemWeb-Frontend/dist  # probar build sin desplegar

# Swagger / OpenAPI documentation
L5_SWAGGER_CONST_HOST=https://rossety.pe/api
L5_SWAGGER_GENERATE_ALWAYS=false
L5_FORMAT_TO_USE_FOR_DOCS=json
